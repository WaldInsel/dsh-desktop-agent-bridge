{
  "name": "dsh-agent-collaboration",
  "version": "0.1.1",
  "private": true,
  "description": "Local agent collaboration inside the existing DeepSeek Harness desktop.",
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "mcp", "multi-agent", "desktop"],
  "repository": {"type": "git", "url": "https://github.com/WaldInsel/dsh-desktop-agent-bridge.git"},
  "homepage": "https://github.com/WaldInsel/dsh-desktop-agent-bridge#readme",
  "bugs": {"url": "https://github.com/WaldInsel/dsh-desktop-agent-bridge/issues"},
  "type": "module",
  "main": "./dist/host.mjs",
  "exports": {
    ".": "./dist/host.mjs",
    "./client": "./dist/client.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-collaboration-mcp": "./dist/mcp.mjs",
    "dsh-collaboration-remote-mcp": "./dist/remote-mcp.mjs"
  },
  "files": ["dist", "scripts/install-local.mjs", "scripts/install-support.mjs", "scripts/update-local.mjs", "scripts/uninstall-local.mjs", "cordis.patch.yml", "README.md", "docs", "LICENSE", "THIRD_PARTY_NOTICES.md", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm test && npm run build && node scripts/check-mcp.mjs && npm run check:release"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "esbuild": "^0.25.0",
    "zod": "^4.4.3"
  },
  "engines": { "node": ">=22", "dsh": "0.2.1-rc.2" }
}
